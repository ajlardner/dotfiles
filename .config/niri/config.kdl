input {
    keyboard {
        xkb {
            layout "us,latam"
            options "grp:alt_space_toggle"
        }
    }
    mouse { accel-speed 0; }
    focus-follows-mouse max-scroll-amount="0%"
}

output "HDMI-A-2" { position x=0 y=0; focus-at-startup; }
output "DP-3" { position x=-1920 y=0; }
output "DP-4" { 
	transform "90"
	position x=1920 y=-420
	layout { 
		default-column-width { proportion 1.0; } 
		preset-column-widths { proportion 1.0; }
	}
} 
output "HDMI-A-1" {
	position x=3000 y=-420
	transform "90"
	layout { 
		default-column-width { proportion 1.0; } 
		preset-column-widths { proportion 1.0; }
	} 
}
output "DP-2" {
	position x=4080 y=-420
	transform "270"
	layout { 
		default-column-width { proportion 1.0; } 
		preset-column-widths { proportion 1.0; }
	} 
}

cursor { xcursor-size 24; }
prefer-no-csd
screenshot-path "~/pictures/screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"
hotkey-overlay { skip-at-startup; }

layout {
    gaps 4
    background-color "#221f22"
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
    focus-ring { off; }
    border {
        width 2
        active-color "#a9dc76ee"
        inactive-color "#49454a"
        urgent-color "#ff6188"
    }
    insert-hint { color "#a9dc7640"; }
}

window-rule { match is-active=false; opacity 0.85; }
window-rule {
    match app-id="^(librewolf|vesktop)$"
    default-column-width { proportion 1.0; }
}

spawn-sh-at-startup "qs"

binds {
    Mod+Q { toggle-window-floating; }
    Mod+W repeat=false { close-window; }
    Mod+E repeat=false { fullscreen-window; }
    Mod+C { switch-preset-column-width; }
    Mod+Space repeat=false { toggle-overview; }
    Mod+A repeat=false { spawn "rofi" "-show" "drun"; }
    Mod+S repeat=false { spawn "foot"; }
    Mod+D repeat=false { spawn-sh "foot yazi"; }
    Mod+F repeat=false { spawn "librewolf"; }
    Mod+Period repeat=false { spawn "rbw unlock && rofi-rbw"; }
    Mod+Equal repeat=false { quit; }

    Mod+H { focus-column-or-monitor-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+Left { focus-monitor-left; }
    Mod+Down { focus-workspace-down; }
    Mod+Up { focus-workspace-up; }
    Mod+Right { focus-monitor-right; }
    Mod+Y { focus-monitor-left; }
    Mod+O { focus-monitor-right; }

    Mod+Shift+H { move-column-to-monitor-right; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+L { move-column-to-monitor-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Print repeat=false { screenshot; }
    Ctrl+Print repeat=false { screenshot-screen; }
    Alt+Print repeat=false { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "playerctl" "previous"; }
}
